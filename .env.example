# Copy to .env and fill in. Never commit .env.

# Gemini (ADR 0009)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# NCBI E-utilities (ADR 0012)
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=

# LangSmith tracing (ADR 0014)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Default email recipient (ADR 0007)
RECIPIENT_EMAIL=

# Gmail OAuth files (paths only; the files themselves are git-ignored)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
